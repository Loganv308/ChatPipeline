# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real credentials.

# ─── Twitch credentials ─────────────────────────────────────────────────────
# From a registered app at https://dev.twitch.tv/console (Register Your
# Application). Set its OAuth Redirect URL to https://localhost.
#
# TWITCH_TOKEN / TWITCH_REFRESH_TOKEN come from running the Authorization
# Code flow once by hand for the account you want chat to connect as:
#   1. Open in a browser (swap in your own client id), logged in as that
#      account, and approve:
#        https://id.twitch.tv/oauth2/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=https://localhost&response_type=code&scope=chat:read+chat:edit
#   2. The browser redirects to https://localhost/?code=XXXX (page load
#      fails, that's expected — the code is in the address bar).
#   3. Exchange that code for tokens:
#        curl -X POST https://id.twitch.tv/oauth2/token \
#          -d client_id=YOUR_CLIENT_ID \
#          -d client_secret=YOUR_CLIENT_SECRET \
#          -d code=THE_CODE_FROM_STEP_2 \
#          -d grant_type=authorization_code \
#          -d redirect_uri=https://localhost
#   4. The response's access_token / refresh_token go below.
#
# TWITCH_TOKEN expires in a few hours. Worker.py refreshes it
# automatically using TWITCH_REFRESH_TOKEN + TWITCH_CLIENT_SECRET before
# it expires (see get_fresh_access_token() in src/Worker.py) — the
# rotated refresh token is then persisted into the local SQLite buffer,
# so after the very first boot, this .env value is only a fallback.
TWITCH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# Numeric Twitch user id of the account TWITCH_TOKEN belongs to. Not
# currently read anywhere in src/ — informational only.
TWITCH_BOT_ID=

# ─── PostgreSQL connection ──────────────────────────────────────────────────
# Used by src/Sync.py and src/Sanitizer.py (src/Worker.py never talks to Postgres directly).
DB_HOST=
DB_PORT=5432
DB_NAME=chatpipeline
DB_USER=postgres
# CAUTION: docker-compose's env_file parsing treats "$" as its own
# escape character — every literal "$" in the password must be written
# as "$$", or Postgres auth will silently fail with the wrong password.
# Example: a real password of  Foo$Bar$$Baz  must be written here as
# Foo$$Bar$$$$Baz. After changing this, verify what actually reaches
# the container before assuming it's right:
#   docker exec <container> printenv DB_PASSWORD
DB_PASSWORD=

# ─── Channels ───────────────────────────────────────────────────────────────
# When set, this is the full list of channels to collect — Worker.py joins
# only these, and Sync.py adds them to Postgres's `channels` table
# automatically. Apply changes with: docker compose up -d
# Leave it empty to take the channel list from Postgres's `channels` table
# instead.
# Comma-separated Twitch login names, or name:id pairs to skip the API
# lookup (requires TWITCH_CLIENT_SECRET to resolve bare names):
#   SEED_CHANNELS=somechannel,otherchannel
#   SEED_CHANNELS=somechannel:123456,otherchannel:654321
SEED_CHANNELS=

# ─── Historical backfill (optional) ─────────────────────────────────────────
# Imports past chat from logs.ivr.fi (Twitch's raw lines, original ids and
# send times) into the same queue as live chat; duplicates are dropped.
# Per channel: name:30 (last 30 days), name:2026-01-01 (back to a date),
# name:all (everything available), or just name (30 days). Channels not
# listed aren't backfilled; empty turns it off. Channels must also be in
# SEED_CHANNELS. Not every channel is logged there -- check with
#   https://logs.ivr.fi/list?channel=<name>
#   BACKFILL_CHANNELS=xqc:30,moonmoon:90,ludwig:2026-01-01

BACKFILL_CHANNELS=

# ─── Daily reports ──────────────────────────────────────────────────────────
# Host folder the reporter writes reports into (and reports-web serves).
# Defaults to ./reports next to docker-compose.yml. Point it at a NAS share
# mounted on the host to have reports backed up, e.g.
#   REPORTS_PATH=/mnt/nas/chatpipeline/reports
REPORTS_PATH=
# Recommended with a NAS: create an empty file named .chatpipeline-reports
# in that folder (on the NAS) once, and set this to true. The reporter then
# only writes there when it can see that marker, so if the share isn't
# mounted, reports aren't silently written to the empty local mount point.
REPORTS_REQUIRE_MARKER=false
# Local folder used instead whenever REPORTS_PATH is unavailable (marker
# missing, or a write fails). Once REPORTS_PATH is back, those reports are
# moved there automatically (within 30 min) and removed from here.
# Defaults to ./reports-fallback next to docker-compose.yml.
REPORTS_FALLBACK_PATH=


# Timezone for the timestamps printed to stdout (docker compose logs).
# Logs sent to LogStream stay in UTC. Defaults to UTC if unset.
TZ=America/Chicago
